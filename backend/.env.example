# Sao chép thành .env (hoặc đặt trong biến môi trường của nơi triển khai). KHÔNG commit file .env.

# ---- Firebase (bắt buộc) ----
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account: dán JSON thô hoặc base64 của file JSON (base64 -w0 service-account.json)
FIREBASE_CREDENTIALS=
# hoặc đường dẫn tới file JSON (dùng một trong hai)
FIREBASE_CREDENTIALS_FILE=
# Firebase Console > Project settings > General > Web API Key
FIREBASE_WEB_API_KEY=

# ---- Cloudinary (bắt buộc khi MEDIA_PROVIDER=cloudinary) ----
# Cloudinary Console > Dashboard > API Environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ---- Chẩn đoán AI (tùy chọn) ----
# none: lưu ảnh, chờ chẩn đoán | claude: dùng Claude (cần ANTHROPIC_API_KEY) | http: gọi mô hình riêng
DIAGNOSIS_PROVIDER=none
ANTHROPIC_API_KEY=
DIAGNOSIS_CLAUDE_MODEL=claude-opus-5-5
DIAGNOSIS_HTTP_URL=
DIAGNOSIS_HTTP_TOKEN=

# ---- Vận hành ----
APP_ENV=prod
PORT=8080
PUBLIC_BASE_URL=https://api.example.com
# Email (phân tách bằng dấu phẩy) được tự gán quyền admin khi đăng ký/khởi động
ADMIN_EMAILS=
# Giới hạn origin cho trình duyệt (app Android không cần). Mặc định cho phép tất cả.
CORS_ALLOWED_ORIGINS=*
# Tắt Swagger UI / OpenAPI ở production nếu không muốn công khai tài liệu
OPENAPI_ENABLED=true
REMINDERS_ENABLED=true

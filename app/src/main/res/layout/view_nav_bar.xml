<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh điều hướng nổi dạng viên thuốc, 5 mục: Trang chủ, Cộng đồng, Quét AI, Ruộng lúa, Cá nhân. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/nav_pill"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_marginStart="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_nav_pill"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="6dp">

        <FrameLayout
            android:id="@+id/nav_home"
            style="@style/NavItem"
            android:contentDescription="Trang chủ">

            <View
                android:id="@+id/nav_home_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_home_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_home_outline" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_community"
            style="@style/NavItem"
            android:contentDescription="Cộng đồng">

            <View
                android:id="@+id/nav_community_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_community_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_group" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_scan"
            style="@style/NavItem"
            android:contentDescription="Quét AI">

            <View
                android:id="@+id/nav_scan_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_scan_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_crop_free" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_fields"
            style="@style/NavItem"
            android:contentDescription="Ruộng lúa">

            <View
                android:id="@+id/nav_fields_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_fields_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_field" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_profile"
            style="@style/NavItem"
            android:contentDescription="Cá nhân">

            <View
                android:id="@+id/nav_profile_blob"
                style="@style/NavBlob" />

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/nav_profile_icon"
                    style="@style/Circle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_default" />

                <View
                    android:id="@+id/nav_profile_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_avatar_ring"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</merge>

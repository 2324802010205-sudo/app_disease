<?xml version="1.0" encoding="utf-8"?>
<!-- Thanh điều hướng nổi dạng viên thuốc. 6 mục: Trang chủ, Ruộng lúa, Quét AI, Thư viện, Thông báo, Cá nhân. -->
<merge xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/nav_pill"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_height"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_nav_pill"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="10dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <FrameLayout
            android:id="@+id/nav_home"
            style="@style/NavItem"
            android:contentDescription="Trang chủ">

            <View
                android:id="@+id/nav_home_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_home_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_home_outline" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_fields"
            style="@style/NavItem"
            android:contentDescription="Ruộng lúa">

            <View
                android:id="@+id/nav_fields_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_fields_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_eco" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_scan"
            style="@style/NavItem"
            android:contentDescription="Quét AI">

            <View
                android:id="@+id/nav_scan_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_scan_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_crop_free" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_library"
            style="@style/NavItem"
            android:contentDescription="Thư viện bệnh">

            <View
                android:id="@+id/nav_library_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_library_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_menu_book" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_notifications"
            style="@style/NavItem"
            android:contentDescription="Thông báo">

            <View
                android:id="@+id/nav_notifications_blob"
                style="@style/NavBlob" />

            <ImageView
                android:id="@+id/nav_notifications_icon"
                style="@style/NavIcon"
                android:src="@drawable/ic_notifications_outline" />

            <TextView
                android:id="@+id/nav_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:minHeight="20dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_nav_badge"
                android:gravity="center"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:minWidth="20dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:text="9+"
                android:textColor="@color/white"
                android:textSize="@dimen/text_12"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nav_profile"
            style="@style/NavItem"
            android:contentDescription="Cá nhân">

            <View
                android:id="@+id/nav_profile_blob"
                style="@style/NavBlob" />

            <FrameLayout
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/nav_profile_icon"
                    style="@style/Circle"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_avatar_default" />

                <View
                    android:id="@+id/nav_profile_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_nav_avatar_ring"
                    android:visibility="gone" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>
</merge>

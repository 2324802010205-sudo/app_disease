<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="128dp"
        android:layout_height="100dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="48dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:id="@+id/btn_back"
                    style="@style/Back"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.H2"
                    android:layout_gravity="center"
                    android:text="Kết quả nhận diện"
                    android:textSize="@dimen/text_21" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="124dp"
                android:layout_marginTop="4dp">

                <com.google.android.material.imageview.ShapeableImageView
                    style="@style/Round16"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter"
                    android:id="@+id/hero" />

                <FrameLayout
                    android:id="@+id/btn_zoom"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_circle_dark">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_zoom_in"
                        app:tint="@color/white" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/Circle"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:padding="2dp"
                        android:scaleType="centerCrop"
                        android:id="@+id/thumb"
                        app:strokeColor="@color/tint_green"
                        app:strokeWidth="3dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T"
                            android:id="@+id/disease_name"
                            tools:text="Đạo ôn lá"
                            android:textColor="@color/ink_deep"
                            android:textSize="@dimen/text_24"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/pill_risk"
                            style="@style/T.Pill"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_pill_red"
                            android:drawableStart="@drawable/ic_error"
                            android:drawableTint="@color/red"
                            tools:text="Nguy cơ cao"
                            android:textColor="@color/red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Body"
                            android:layout_marginTop="6dp"
                            android:id="@+id/disease_desc"
                            tools:text="Bệnh do nấm Magnaporthe oryzae gây ra, thường xuất hiện trên lá lúa."
                            android:textSize="@dimen/text_15" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="80dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="#E7E7DE" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Small"
                            android:text="Độ tin cậy"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_14" />

                        <FrameLayout
                            android:layout_width="62dp"
                            android:layout_height="62dp"
                            android:layout_marginTop="6dp">

                            <ProgressBar
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:max="100"
                                android:id="@+id/confidence_ring"
                                android:progress="0"
                                android:progressDrawable="@drawable/bg_ring_progress" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:layout_gravity="center"
                                android:id="@+id/confidence_text"
                                tools:text="92%"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_18"
                                android:textStyle="bold" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="#EEEDE5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_schedule"
                            app:tint="@color/ink" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Thời gian quét"
                                android:textSize="@dimen/text_14" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:layout_marginTop="1dp"
                                android:id="@+id/scan_time"
                                tools:text="09:41, 24/04/2025"
                                android:textSize="@dimen/text_15"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_sprout"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Giai đoạn lúa"
                                android:textSize="@dimen/text_14" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:layout_marginTop="1dp"
                                android:id="@+id/scan_stage"
                                tools:text="Đẻ nhánh"
                                android:textSize="@dimen/text_15"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_description"
                            app:tint="@color/ink" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Giống lúa"
                                android:textSize="@dimen/text_14" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:layout_marginTop="1dp"
                                android:id="@+id/scan_variety"
                                tools:text="OM 5451"
                                android:textSize="@dimen/text_15"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- symptoms -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_tint"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_tint">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_eco"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.H3"
                        android:layout_marginStart="10dp"
                        android:text="Triệu chứng nhận thấy" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_symptoms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- quick advice -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_warm"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_circle_amber">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_lightbulb"
                            app:tint="#F2A91B" />
                    </FrameLayout>

                    <TextView
                        android:layout_height="wrap_content"
                        style="@style/T.H3"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="Khuyến nghị nhanh" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/orange" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/state_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_amber"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/state_title"
                    style="@style/T.H3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/state_text"
                    style="@style/T.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/btn_retry"
                    style="@style/Btn.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="Thử lại" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_field"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location_on"
                    app:tint="@color/ink_deep" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Small"
                        android:text="Ruộng được chọn"
                        android:textSize="@dimen/text_14" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.H3"
                        android:layout_marginTop="1dp"
                        android:id="@+id/field_label"
                        tools:text="Ruộng Bờ Đông"
                        android:textSize="@dimen/text_17" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Link"
                    android:drawableEnd="@drawable/ic_chevron_right"
                    android:drawableTint="@color/primary"
                    android:text="Xem chi tiết" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.example.project_final.view.IconTextView
                    android:id="@+id/btn_save"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_history"
                    android:drawablePadding="8dp"
                    android:text="Lịch sử quét"
                    android:textSize="@dimen/text_17" />

                <com.example.project_final.view.IconTextView
                    android:id="@+id/btn_feedback"
                    style="@style/Btn.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_comment"
                    android:drawablePadding="8dp"
                    android:text="Gửi phản hồi"
                    android:textSize="@dimen/text_17" />
            </LinearLayout>

            <com.example.project_final.view.IconTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:id="@+id/btn_related"
                style="@style/Btn.Primary"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_sparkle"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:drawablePadding="12dp"
                android:text="Xem bệnh liên quan" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

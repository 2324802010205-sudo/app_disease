<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <TextView
        android:id="@+id/sheet_title"
        style="@style/T.H2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chọn nguồn ảnh" />

    <TextView
        android:id="@+id/sheet_camera"
        style="@style/Btn.Soft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:drawableStart="@drawable/ic_photo_camera"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:text="Chụp ảnh mới" />

    <TextView
        android:id="@+id/sheet_gallery"
        style="@style/Btn.Soft"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:drawableStart="@drawable/ic_photo_outline"
        android:gravity="center_vertical"
        android:minHeight="54dp"
        android:text="Chọn từ thư viện" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="128dp"
        android:layout_height="100dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_header_logo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Title"
                    android:layout_marginTop="4dp"
                    android:text="Chi tiết kết quả"
                    android:textSize="@dimen/text_29" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Sub"
                    android:layout_marginTop="5dp"
                    android:text="Thông tin chi tiết từ lần phân tích ảnh lá lúa của bạn."
                    android:textSize="@dimen/text_17" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="165dp"
                    android:layout_marginTop="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/Round16"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:id="@+id/hero" />

                    <FrameLayout
                        android:id="@+id/btn_zoom"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_circle_dark">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_zoom_in"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_circle_tint">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_eco"
                                app:tint="@color/orange" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Kết quả phân tích"
                                android:textSize="@dimen/text_14" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:layout_marginTop="1dp"
                                android:id="@+id/disease_name"
                                tools:text="Đạo ôn lá"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_23"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:layout_marginTop="2dp"
                                android:id="@+id/disease_desc"
                                tools:text="Bệnh do nấm Magnaporthe oryzae gây ra, thường xuất hiện trên lá, cổ bông."
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Độ tin cậy"
                                android:textSize="@dimen/text_14" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ProgressBar
                                    style="?android:attr/progressBarStyleHorizontal"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:max="100"
                                    android:progress="92"
                                    android:progressDrawable="@drawable/bg_ring_progress" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T"
                                    android:layout_marginStart="6dp"
                                    android:id="@+id/confidence_text"
                                    tools:text="92%"
                                    android:textColor="@color/ink_deep"
                                    android:textSize="@dimen/text_18"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Pill"
                                android:layout_marginTop="6dp"
                                android:background="@drawable/bg_pill_orange"
                                android:drawableStart="@drawable/ic_warning"
                                android:drawableTint="@color/orange"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:id="@+id/pill_risk"
                                tools:text="Nguy cơ cao"
                                android:textColor="@color/orange"
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:background="#EEEDE5" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_calendar"
                                app:tint="@color/ink_deep" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T.Small"
                                    android:text="Thời gian quét"
                                    android:textSize="@dimen/text_13" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T"
                                    android:layout_marginTop="1dp"
                                    android:id="@+id/scan_time"
                                    tools:text="09:41, 24/04/2025"
                                    android:textSize="@dimen/text_15"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/row_field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_location_on"
                                app:tint="@color/ink_deep" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T.Small"
                                    android:text="Ruộng liên kết"
                                    android:textSize="@dimen/text_13" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T"
                                    android:layout_marginTop="1dp"
                                    android:id="@+id/field_label"
                                    tools:text="Ruộng Bờ Đông"
                                    android:textSize="@dimen/text_15"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_chevron_right"
                                app:tint="@color/ink" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_tint"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_circle_tint">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_eco"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.H3"
                            android:layout_marginStart="8dp"
                            android:text="Tóm tắt" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/list_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_circle_primary">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_description"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.H3"
                            android:layout_marginStart="8dp"
                            android:text="Thông tin liên quan" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/list_related"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                    <com.example.project_final.view.IconTextView
                        android:id="@+id/btn_compare"
                        style="@style/Btn.Outline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/ic_swap_horiz"
                        android:minHeight="50dp"
                        android:text="So sánh với lần quét khác" />

                    <com.example.project_final.view.IconTextView
                        android:layout_width="match_parent"
                        android:id="@+id/btn_delete"
                        style="@style/Btn.Danger"
                        android:layout_height="wrap_content"
                android:minHeight="44dp"
                        android:layout_marginTop="8dp"
                        android:drawableStart="@drawable/ic_delete"
                        android:drawablePadding="8dp"
                        android:text="Xóa bản ghi"
                        android:textSize="@dimen/text_17" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bar_bottom"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.example.project_final.view.IconTextView
                    android:id="@+id/btn_library"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_menu_book"
                    android:drawablePadding="8dp"
                    android:text="Thư viện bệnh"
                    android:textSize="@dimen/text_16" />

                <com.example.project_final.view.IconTextView
                    android:id="@+id/btn_rescan"
                    style="@style/Btn.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_photo_camera"
                    android:drawablePadding="8dp"
                    android:text="Quét lại"
                    android:textSize="@dimen/text_16" />
            </LinearLayout>


        </LinearLayout>
    </LinearLayout>
</FrameLayout>

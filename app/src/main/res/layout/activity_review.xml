<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="128dp"
        android:layout_height="100dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_header_logo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Title"
                    android:layout_marginTop="10dp"
                    android:text="Xem lại ảnh"
                    android:textSize="@dimen/text_30" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Sub"
                    android:layout_marginTop="6dp"
                    android:text="Hãy kiểm tra ảnh trước khi phân tích để đảm bảo kết quả chính xác nhất."
                    android:textSize="@dimen/text_17" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="236dp"
                    android:layout_marginTop="14dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/Round16"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:id="@+id/photo" />

                    <FrameLayout
                        android:id="@+id/btn_zoom"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="10dp"
                        android:background="@drawable/bg_circle_dark">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_zoom_in"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card_tint"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <FrameLayout
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_circle_tint">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_eco"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.H3"
                            android:text="Kiểm tra nhanh trước khi phân tích"
                            android:textSize="@dimen/text_17" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Body"
                            android:layout_marginTop="6dp"
                            android:drawableStart="@drawable/ic_check_circle"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/primary"
                            android:text="Lá lúa nằm trong khung và rõ nét"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Body"
                            android:layout_marginTop="5dp"
                            android:drawableStart="@drawable/ic_check_circle"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/primary"
                            android:text="Đủ ánh sáng, không rung hoặc mờ"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_15" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Body"
                            android:layout_marginTop="5dp"
                            android:drawableStart="@drawable/ic_check_circle"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/primary"
                            android:text="Thấy rõ vùng lá có vết bệnh"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_15" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_field"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_location_on"
                        app:tint="@color/ink_deep" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Small"
                            android:text="Ruộng được chọn" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/field_name"
                            style="@style/T.H3"
                            android:layout_marginTop="2dp"
                            tools:text="Ruộng số 1 - Thửa A"
                            android:textSize="@dimen/text_17" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_choose_field"
                        style="@style/T.Link"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawableTint="@color/primary"
                        android:text="Chọn ruộng" />
                </LinearLayout>

                <EditText
                    android:id="@+id/input_note"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Ghi chú (không bắt buộc)"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="500"
                    android:minHeight="52dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <com.example.project_final.view.IconTextView
                        android:id="@+id/btn_retake"
                        style="@style/Btn.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
        android:minHeight="48dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_photo_camera"
                        android:drawablePadding="8dp"
                        android:text="Chụp lại" />

                    <com.example.project_final.view.IconTextView
                        android:id="@+id/btn_replace"
                        style="@style/Btn.Outline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
        android:minHeight="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:drawableStart="@drawable/ic_photo_outline"
                        android:drawablePadding="8dp"
                        android:text="Thay ảnh" />
                </LinearLayout>

                <com.example.project_final.view.IconTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
        android:minHeight="52dp"
                    android:id="@+id/btn_analyze"
                    style="@style/Btn.Primary"
                    android:layout_marginTop="10dp"
                    android:drawableStart="@drawable/ic_sparkle"
                    android:drawableEnd="@drawable/ic_arrow_forward"
                    android:drawablePadding="12dp"
                    android:text="Bắt đầu phân tích" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

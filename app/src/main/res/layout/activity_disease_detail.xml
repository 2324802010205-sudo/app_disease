<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_header_logo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Title"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:text="Chi tiết bệnh"
                    android:textSize="@dimen/text_25" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="190dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            style="@style/Round16"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:id="@+id/hero" />

                        <FrameLayout
                            android:id="@+id/btn_zoom"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="8dp"
                            android:background="@drawable/bg_circle_dark">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_zoom_in"
                                app:tint="@color/white" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:id="@+id/disease_name"
                                tools:text="Đạo ôn lá"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_23"
                                android:textStyle="bold" />

                            <FrameLayout
                                android:id="@+id/btn_bookmark_top"
                                android:layout_width="34dp"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_card">

                                <ImageView
                                    android:id="@+id/icon_bookmark_top"
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_bookmark"
                                    app:tint="@color/primary" />
                            </FrameLayout>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Pill"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_chip_soft"
                            android:drawableStart="@drawable/ic_eco"
                            android:drawableTint="@color/primary"
                            android:id="@+id/disease_cause"
                            tools:text="Bệnh do nấm"
                            android:textColor="@color/primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Body"
                            android:layout_marginTop="8dp"
                            android:id="@+id/disease_desc"
                            tools:text="Đạo ôn lá là bệnh hại phổ biến trên cây lúa, do nấm Magnaporthe oryzae gây ra, có thể giảm năng suất nghiêm trọng nếu không được kiểm soát kịp thời."
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_15" />
                    </LinearLayout>
                </LinearLayout>

                <!-- overview -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_tint">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_circle_tint">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_eco"
                                    app:tint="@color/primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.H3"
                                android:layout_marginStart="8dp"
                                android:text="Tổng quan" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Body"
                            android:layout_marginTop="6dp"
                            android:id="@+id/disease_overview"
                            tools:text="Bệnh thường xuất hiện ở tất cả các giai đoạn sinh trưởng, đặc biệt mạnh trong điều kiện ẩm độ cao và thời tiết mát. Bệnh có thể lây lan nhanh qua gió, nước và tàn dư cây bệnh."
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_15" />
                    </LinearLayout>
                </FrameLayout>

                <!-- signs -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_circle_orange">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_eco"
                                    app:tint="@color/orange" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.H3"
                                android:layout_marginStart="8dp"
                                android:text="Dấu hiệu nhận biết" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/list_signs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:layout_marginEnd="86dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </FrameLayout>

                <!-- conditions -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_circle_blue">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_w_rain" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.H3"
                                android:layout_marginStart="8dp"
                                android:text="Điều kiện liên quan" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/list_conditions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </FrameLayout>

                <!-- prevention -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card_tint">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_circle_tint">

                                <ImageView
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_shield_check"
                                    app:tint="@color/primary" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.H3"
                                android:layout_marginStart="8dp"
                                android:text="Xử lý &amp; phòng ngừa" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/list_prevention"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/row_source"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_menu_book"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T"
                            android:text="Nguồn tham khảo"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Small"
                            android:layout_marginTop="2dp"
                            android:text="Cục Bảo vệ thực vật (2022). Sổ tay hướng dẫn phòng trừ một số bệnh hại chính trên cây lúa. Bộ Nông nghiệp và Phát triển Nông thôn."
                            android:textSize="@dimen/text_13" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/primary" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bar_bottom"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <com.example.project_final.view.IconTextView
                android:id="@+id/btn_scan"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="46dp"
                android:layout_weight="1.2"
                android:drawableStart="@drawable/ic_crop_free"
                android:drawablePadding="8dp"
                android:text="Quét ngay" />

            <com.example.project_final.view.IconTextView
                android:id="@+id/btn_save"
                style="@style/Btn.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="46dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_bookmark_border"
                android:drawablePadding="8dp"
                android:text="Lưu" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

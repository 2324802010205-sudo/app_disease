<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/avatar"
            style="@style/Circle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/author"
                style="@style/T"
                android:textColor="@color/ink_deep"
                android:textSize="@dimen/text_17"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/meta"
                style="@style/T.Small"
                android:layout_marginTop="2dp"
                android:textSize="@dimen/text_14" />

        </LinearLayout>


        <TextView
            android:id="@+id/topic"
            style="@style/T.Pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:drawablePadding="6dp"
            android:textSize="@dimen/text_14" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:importantForAccessibility="no"
            android:padding="4dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ink" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/title"
        style="@style/T"
        android:layout_marginTop="8dp"
        android:textColor="@color/ink_deep"
        android:textSize="@dimen/text_18"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/excerpt"
        style="@style/T.Body"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textSize="@dimen/text_16" />

    <LinearLayout
        android:id="@+id/photos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/like"
            style="@style/T"
            android:drawableStart="@drawable/ic_thumb_up"
            android:drawablePadding="6dp"
            android:drawableTint="@color/primary"
            android:padding="4dp"
            android:textColor="@color/ink_deep"
            android:textSize="@dimen/text_16"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/comment"
            style="@style/T"
            android:layout_marginStart="14dp"
            android:drawableStart="@drawable/ic_comment"
            android:drawablePadding="6dp"
            android:drawableTint="@color/ink_deep"
            android:padding="4dp"
            android:textSize="@dimen/text_16" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/share"
            style="@style/T"
            android:layout_marginStart="14dp"
            android:drawableStart="@drawable/ic_share"
            android:drawablePadding="6dp"
            android:drawableTint="@color/ink_deep"
            android:padding="4dp"
            android:text="Chia sẻ"
            android:textSize="@dimen/text_16" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/report"
            style="@style/T"
            android:drawableStart="@drawable/ic_warning"
            android:drawablePadding="5dp"
            android:drawableTint="@color/muted"
            android:padding="4dp"
            android:text="Báo cáo"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_15" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/left"
        style="@style/T"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:background="@drawable/bg_card_red"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:textSize="@dimen/text_14" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="0.8"
        android:background="@drawable/bg_input"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="6dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            app:tint="@color/ink_deep" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/label"
            style="@style/T"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/right"
        style="@style/T"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.15"
        android:background="@drawable/bg_card_tint"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:textSize="@dimen/text_14" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Lớp phủ trạng thái dùng chung: đang tải / không có dữ liệu / lỗi kèm nút thử lại. -->
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ProgressBar
        android:id="@+id/state_progress"
        style="?android:attr/progressBarStyle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminateTint="@color/primary" />

    <ImageView
        android:id="@+id/state_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_info"
        android:visibility="gone"
        app:tint="@color/hint" />

    <TextView
        android:id="@+id/state_title"
        style="@style/T.H3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/state_message"
        style="@style/T.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/state_retry"
        style="@style/Btn.Soft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:minHeight="48dp"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:text="Thử lại"
        android:visibility="gone" />
</LinearLayout>

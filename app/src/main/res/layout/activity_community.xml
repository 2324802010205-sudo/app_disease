<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:tag="deco"
            android:layout_width="150dp"
            android:layout_height="120dp"
            android:layout_gravity="end"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/img_deco_panicle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="-8dp"
                    android:padding="8dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/ink_deep" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="38dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/img_logo" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T"
                        android:text="Cộng đồng nông dân"
                        android:textColor="@color/ink_deep"
                        android:textSize="@dimen/text_22"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Small"
                        android:layout_marginTop="1dp"
                        android:text="Chia sẻ kinh nghiệm – Cùng nhau vụ mùa bội thu"
                        android:textSize="@dimen/text_14" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        app:tint="@color/ink_deep" />

                    <EditText
                        android:id="@+id/input_search"
                        style="@style/T"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Tìm bài viết, chủ đề..."
                        android:inputType="text"
                        android:maxLines="1"
                        android:textColorHint="@color/hint"
                        android:textSize="@dimen/text_16" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:id="@+id/btn_my_posts"
                    style="@style/T"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_soft"
                    android:drawableStart="@drawable/ic_person_outline"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/ink_deep"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Bài của tôi"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="8dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="96dp">

                    <LinearLayout
                        android:id="@+id/list_posts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/btn_more"
                        style="@style/Btn.Soft"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:minHeight="48dp"
                        android:text="Xem thêm bài viết"
                        android:visibility="gone" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <com.example.project_final.view.IconTextView
            android:id="@+id/btn_write"
            style="@style/T"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_btn_pill"
            android:drawableStart="@drawable/ic_edit"
            android:drawablePadding="6dp"
            android:drawableTint="@color/white"
            android:elevation="6dp"
            android:gravity="center"
            android:minHeight="44dp"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:text="Viết bài"
            android:textColor="@color/white"
            android:textSize="@dimen/text_15"
            android:textStyle="bold" />
    </FrameLayout>

</LinearLayout>

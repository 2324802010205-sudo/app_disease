<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="115dp"
        android:layout_height="140dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_tl" />

    <ImageView
        android:tag="deco"
        android:layout_width="90dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_tr" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="30dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="66dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/img_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T"
                    android:text="RiceGuard "
                    android:textColor="@color/ink_deep"
                    android:textSize="@dimen/text_22"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T"
                    android:text="AI"
                    android:textColor="@color/green_ok"
                    android:textSize="@dimen/text_22"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="14dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/img_forgot_envelope" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Title"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Quên mật khẩu"
                android:textSize="@dimen/text_29" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Sub"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Nhập email của bạn để nhận liên kết đặt lại mật khẩu. Chúng tôi sẽ gửi hướng dẫn vào hộp thư của bạn." />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:id="@+id/input_email"
                style="@style/Input"
                android:layout_marginTop="22dp"
                android:drawableStart="@drawable/ic_mail"
                android:hint="Email"
                android:inputType="textEmailAddress" />

            <com.example.project_final.view.IconTextView
                android:layout_width="match_parent"
                android:id="@+id/btn_send"
                style="@style/Btn.Primary"
                android:layout_height="wrap_content"
        android:minHeight="48dp"
                android:layout_marginTop="14dp"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:text="Gửi yêu cầu" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/btn_back_login"
                style="@style/T.Link"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:drawableStart="@drawable/ic_arrow_back"
                android:drawablePadding="8dp"
                android:drawableTint="@color/primary"
                android:padding="8dp"
                android:text="Quay lại đăng nhập" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

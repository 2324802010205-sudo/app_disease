<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:minHeight="48dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:id="@+id/btn_back"
                style="@style/Back"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.H2"
                android:layout_gravity="center"
                android:text="Chi tiết bài viết"
                android:textSize="@dimen/text_21" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/post_avatar"
                            style="@style/Circle"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/post_author"
                                style="@style/T"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_17"
                                android:textStyle="bold"
                                tools:text="Nguyễn Văn Hòa" />

                            <TextView
                                android:id="@+id/post_meta"
                                style="@style/T.Small"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="@dimen/text_14"
                                tools:text="2 ngày trước · Thái Bình" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/post_topic"
                            style="@style/T.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pill_green"
                            android:drawableStart="@drawable/ic_eco"
                            android:drawablePadding="6dp"
                            android:drawableTint="@color/green_ok"
                            android:textColor="@color/green_ok"
                            tools:text="Sâu bệnh" />

                        <ImageView
                            android:id="@+id/post_menu"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:contentDescription="Tùy chọn"
                            android:padding="6dp"
                            android:src="@drawable/ic_more_vert"
                            app:tint="@color/ink" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T"
                        android:layout_marginTop="12dp"
                        android:id="@+id/post_title"
                        tools:text="Lúa bị đạo ôn lá, nên xử lý thế nào?"
                        android:textColor="@color/ink_deep"
                        android:textSize="@dimen/text_22"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Body"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:id="@+id/post_body"
                        tools:text="Ruộng lúa của tôi đang 35 ngày tuổi, gần đây xuất hiện nhiều vết bệnh hình thoi màu nâu xám trên lá, có vẻ lan rộng. Không biết đây có phải là đạo ôn lá không và nên phun thuốc gì, liều lượng bao nhiêu cho hiệu quả?\nMong bà con có kinh nghiệm chia sẻ giúp. Cảm ơn nhiều!"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_17" />

                    <LinearLayout
                        android:id="@+id/post_photos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_divider_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.example.project_final.view.IconTextView
                            android:id="@+id/like"
                            style="@style/T"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:drawableStart="@drawable/ic_thumb_up"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/primary"
                            android:gravity="center"
                            android:minHeight="48dp"
                            tools:text="0"
                            android:textColor="@color/ink_deep"
                            android:textSize="@dimen/text_16"
                            android:textStyle="bold" />

                        <com.example.project_final.view.IconTextView
                            android:id="@+id/comment_count"
                            style="@style/T"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:drawableStart="@drawable/ic_comment"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/ink_deep"
                            android:gravity="center"
                            android:minHeight="48dp"
                            tools:text="0"
                            android:textColor="@color/ink_deep"
                            android:textSize="@dimen/text_16" />

                        <com.example.project_final.view.IconTextView
                            android:id="@+id/share"
                            style="@style/T"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:drawableStart="@drawable/ic_share"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/ink_deep"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:text="Chia sẻ"
                            android:textColor="@color/ink_deep"
                            android:textSize="@dimen/text_16" />

                        <com.example.project_final.view.IconTextView
                            android:id="@+id/save"
                            style="@style/T"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="?attr/selectableItemBackground"
                            android:drawableStart="@drawable/ic_bookmark_border"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/ink_deep"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:text="Lưu"
                            android:textColor="@color/ink_deep"
                            android:textSize="@dimen/text_16" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_height="wrap_content"
                        style="@style/T.H2"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:id="@+id/comments_title"
                        tools:text="Bình luận (8)" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/dd_sort"
                        style="@style/T.Link"
                        android:drawableEnd="@drawable/ic_expand_more"
                        android:drawableTint="@color/primary"
                        android:text="Mới nhất"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_comments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/reply_hint"
            style="@style/T.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tint_green_soft"
            android:drawableEnd="@drawable/ic_close"
            android:drawableTint="@color/ink"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textSize="@dimen/text_14"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bar_bottom"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <com.google.android.material.imageview.ShapeableImageView
                style="@style/Circle"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="centerCrop"
                android:id="@+id/my_avatar" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <EditText
                    android:id="@+id/input_comment"
                    style="@style/T"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Viết bình luận..."
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:textColorHint="@color/hint"
                    android:textSize="@dimen/text_16" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_photo_outline"
                    app:tint="@color/ink_deep" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btn_send"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_primary">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_send"
                    app:tint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:minHeight="48dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:id="@+id/btn_back"
                style="@style/Back"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.H2"
                android:layout_gravity="center"
                android:text="Thông báo"
                android:textSize="@dimen/text_22" />
        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="@dimen/nav_clearance">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_banner_tint"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_notifications_outline"
                        app:tint="@color/primary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/banner_title"
                            style="@style/T"
                            tools:text="Bạn có 3 thông báo chưa đọc"
                            android:textSize="@dimen/text_16"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Small"
                            android:layout_marginTop="2dp"
                            android:text="Cập nhật để không bỏ lỡ thông tin quan trọng về ruộng lúa của bạn."
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_read_all"
                        style="@style/T.Link"
                        android:layout_marginStart="6dp"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/primary"
                        android:text="Đánh dấu\nđọc tất cả"
                        android:textSize="@dimen/text_14" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_notifications"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btn_more"
                    style="@style/Btn.Soft"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="48dp"
                    android:text="Xem thêm"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <com.example.project_final.view.NavBar
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>

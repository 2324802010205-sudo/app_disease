<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <ImageView
        android:tag="deco" android:layout_width="150dp" android:layout_height="110dp" android:layout_gravity="end" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/img_deco_panicle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp">
            <ImageView
    android:layout_width="40dp"
    android:layout_height="40dp" android:id="@+id/btn_back" style="@style/Back" android:layout_gravity="center_vertical" android:layout_marginStart="14dp" />
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H2" android:layout_gravity="center" android:id="@+id/screen_title"
 tools:text="Thêm ruộng mới" android:textColor="@color/primary" android:textSize="@dimen/text_22" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:layout_gravity="center_horizontal" android:layout_marginStart="40dp" android:layout_marginEnd="40dp" android:layout_marginBottom="10dp" android:gravity="center" android:text="Thêm thông tin ruộng để RiceGuard AI đồng hành cùng bạn suốt vụ mùa." android:textSize="@dimen/text_15" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="@drawable/bg_sheet_top" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_sprout" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Tên ruộng" android:textSize="@dimen/text_17" />
    </LinearLayout>
    <EditText
    android:layout_width="match_parent" android:id="@+id/input_name" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="46dp" android:layout_marginTop="8dp" android:hint="Ví dụ: Ruộng số 1, Thửa A..." android:textSize="@dimen/text_16" android:inputType="textCapSentences" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_eco" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Giống lúa" android:textSize="@dimen/text_17" />
    </LinearLayout>
    <TextView
    android:layout_width="match_parent" android:id="@+id/dd_variety" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="46dp" android:layout_marginTop="8dp" android:drawableEnd="@drawable/ic_expand_more" android:drawableTint="@color/ink_deep" android:gravity="center_vertical" android:text="Chọn giống lúa" android:textColor="@color/hint" android:textSize="@dimen/text_16" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_crop_free" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Diện tích" android:textSize="@dimen/text_17" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <EditText android:id="@+id/input_area" style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="46dp" android:layout_weight="1" android:hint="Nhập diện tích" android:inputType="numberDecimal" android:textSize="@dimen/text_16" />
        <TextView style="@style/T" android:layout_width="56dp" android:layout_height="wrap_content"
        android:minHeight="46dp" android:layout_marginStart="6dp" android:background="@drawable/bg_input" android:gravity="center" android:text="ha" android:textSize="@dimen/text_16" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_calendar" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Ngày gieo" android:textSize="@dimen/text_17" />
    </LinearLayout>
    <TextView
    android:layout_width="match_parent" android:id="@+id/dd_date" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="46dp" android:layout_marginTop="8dp" android:drawableEnd="@drawable/ic_calendar" android:drawableTint="@color/ink_deep" android:gravity="center_vertical" android:text="Chọn ngày gieo" android:textColor="@color/hint" android:textSize="@dimen/text_16" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_sprout" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Giai đoạn hiện tại" android:textSize="@dimen/text_17" />
    </LinearLayout>
    <TextView
    android:layout_width="match_parent" android:id="@+id/dd_stage" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="46dp" android:layout_marginTop="8dp" android:drawableEnd="@drawable/ic_expand_more" android:drawableTint="@color/ink_deep" android:gravity="center_vertical" android:text="Chọn giai đoạn" android:textColor="@color/hint" android:textSize="@dimen/text_16" />
    <LinearLayout android:id="@+id/btn_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card_tint" android:gravity="center_vertical" android:orientation="horizontal" android:padding="10dp">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_primary">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_location_on" app:tint="@color/white" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:id="@+id/location_title" style="@style/T.H3" android:text="Vị trí ruộng" android:textSize="@dimen/text_17" />
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:id="@+id/location_desc" style="@style/T.Small" android:layout_marginTop="2dp" android:text="Chọn vị trí trên bản đồ để xác định khu vực ruộng" android:textSize="@dimen/text_14" />
        </LinearLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Link" android:drawableEnd="@drawable/ic_chevron_right" android:drawableTint="@color/primary" android:id="@+id/location_action"
 tools:text="Chọn vị trí" android:textSize="@dimen/text_16" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_photo_outline" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Ảnh ruộng" android:textSize="@dimen/text_17" />
    </LinearLayout>
    <LinearLayout android:id="@+id/btn_photo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_dashed_box" android:gravity="center_vertical" android:orientation="horizontal" android:padding="14dp">
        <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_add_photo" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:id="@+id/photo_title"
 tools:text="Chụp hoặc chọn ảnh ruộng" android:textSize="@dimen/text_17" />
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:layout_marginTop="2dp" android:id="@+id/photo_desc"
 tools:text="Hỗ trợ định dạng JPG, PNG (tối đa 10MB)" android:textSize="@dimen/text_14" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_description" app:tint="@color/primary" />
        </FrameLayout>
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:layout_marginStart="10dp" android:text="Ghi chú" android:textSize="@dimen/text_17" />
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:layout_marginStart="4dp" android:text="(tùy chọn)" android:textSize="@dimen/text_15" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <EditText
    android:layout_width="match_parent" android:id="@+id/input_note" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="84dp" android:gravity="top|start" android:hint="Nhập ghi chú về đặc điểm ruộng, tình trạng đất, ..." android:inputType="textMultiLine|textCapSentences" android:maxLength="200" android:maxLines="4" android:paddingTop="12dp" android:paddingBottom="22dp" android:textSize="@dimen/text_16" />
        <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:id="@+id/counter" style="@style/T.Small" android:layout_gravity="bottom|end" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp" android:text="0/200" android:textSize="@dimen/text_14" />
    </FrameLayout>
        </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg" android:orientation="horizontal" android:paddingStart="16dp" android:paddingTop="8dp" android:paddingEnd="16dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/btn_cancel" style="@style/Btn.Outline" android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="48dp" android:layout_weight="1" android:text="Hủy" />
            <com.example.project_final.view.IconTextView android:id="@+id/btn_save" style="@style/Btn.Primary" android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="48dp" android:layout_marginStart="10dp" android:layout_weight="1.4" android:drawableStart="@drawable/ic_sparkle" android:text="Lưu ruộng" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

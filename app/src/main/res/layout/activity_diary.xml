<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="120dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include layout="@layout/view_header_logo" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Title"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="4dp"
                    android:text="Nhật ký chăm sóc"
                    android:textSize="@dimen/text_29" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Sub"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="5dp"
                    android:text="Theo dõi toàn bộ hoạt động chăm sóc và quản lý ruộng lúa để cây trồng phát triển tốt hơn."
                    android:textSize="@dimen/text_16" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/row_field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="58dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="6dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            style="@style/Round10"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:scaleType="centerCrop"
                            android:id="@+id/field_thumb" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:id="@+id/field_name"
                                tools:text="Ruộng Bờ Đông"
                                android:textSize="@dimen/text_16"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:layout_marginTop="1dp"
                                android:id="@+id/field_meta"
                                tools:text="1,6 ha  |  Lúa Đài Thơm 8"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="@color/ink" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dd_range"
                        style="@style/T"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:background="@drawable/bg_card"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawableEnd="@drawable/ic_expand_more"
                        android:drawablePadding="6dp"
                        android:drawableTint="@color/ink_deep"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:text="30 ngày"
                        android:textSize="@dimen/text_16" />

                    <com.example.project_final.view.IconTextView
                        android:id="@+id/btn_add"
                        style="@style/Btn.Primary"
                        android:layout_width="0dp"
                        android:layout_weight="1.3"
                        android:layout_height="wrap_content"
                        android:minHeight="50dp"
                        android:layout_marginStart="8dp"
                        android:drawableStart="@drawable/ic_add_circle"
                        android:drawablePadding="4dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="Thêm nhật ký"
                        android:textSize="@dimen/text_15" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_banner_tint"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_tint">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_eco"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:id="@+id/n_entries"
                                tools:text="5"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_22"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Số hoạt động"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_14"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:id="@+id/n_entries_sub"
                                tools:text="Trong 30 ngày qua"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_tint">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_photo"
                                app:tint="@color/primary" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:id="@+id/n_photos"
                                tools:text="3"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_22"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Số ảnh"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_14"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Đã lưu trữ"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_circle_orange">

                            <ImageView
                                android:layout_width="19dp"
                                android:layout_height="19dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_notifications"
                                app:tint="@color/orange" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T"
                                android:id="@+id/n_reminders"
                                tools:text="1"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_22"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:text="Nhắc lịch"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_14"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:id="@+id/n_reminders_sub"
                                tools:text="Sắp tới"
                                android:textSize="@dimen/text_13" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <com.example.project_final.view.IconTextView
                    android:layout_width="match_parent"
                    android:id="@+id/btn_more"
                    style="@style/Btn.Soft"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_marginTop="8dp"
                    android:drawableStart="@drawable/ic_expand_more"
                    android:drawablePadding="6dp"
                    android:text="Xem thêm nhật ký"
                    android:textSize="@dimen/text_16" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal"
    android:padding="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/img"
        style="@style/Round12"
        android:layout_width="86dp"
        android:layout_height="96dp"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/title"
            style="@style/T"
            android:textColor="@color/ink_deep"
            android:textSize="@dimen/text_17"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/topic"
            style="@style/T.Pill"
            android:layout_marginTop="5dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:textSize="@dimen/text_14" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/date"
            style="@style/T.Small"
            android:layout_marginTop="6dp"
            android:drawableStart="@drawable/ic_calendar"
            android:drawablePadding="5dp"
            android:drawableTint="@color/muted"
            android:textSize="@dimen/text_14" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/likes"
                style="@style/T"
                android:drawableStart="@drawable/ic_thumb_up"
                android:drawablePadding="4dp"
                android:drawableTint="@color/primary"
                android:textSize="@dimen/text_15"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/comments"
                style="@style/T"
                android:layout_marginStart="12dp"
                android:drawableStart="@drawable/ic_comment"
                android:drawablePadding="4dp"
                android:drawableTint="@color/ink_deep"
                android:textSize="@dimen/text_15" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/ink" />

        <TextView
            android:id="@+id/btn_edit"
            style="@style/T"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_btn_soft"
            android:drawableStart="@drawable/ic_edit"
            android:drawableTint="@color/ink_deep"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="Sửa bài viết"
            android:textSize="@dimen/text_15" />

        <TextView
            android:id="@+id/btn_delete"
            style="@style/T"
            android:layout_width="44dp"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pill_red"
            android:drawableStart="@drawable/ic_delete"
            android:drawableTint="@color/red"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:contentDescription="Xóa bài viết"
            android:textColor="@color/red"
            android:textSize="@dimen/text_15" />
    </LinearLayout>
</LinearLayout>

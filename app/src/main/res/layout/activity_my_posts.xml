<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:minHeight="52dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:id="@+id/btn_back"
                style="@style/Back"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.H2"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="64dp"
                android:text="Bài viết của tôi"
                android:textSize="@dimen/text_22" />

            <TextView
                android:id="@+id/btn_new"
                style="@style/Btn.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:minHeight="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="12dp"
                android:drawableStart="@drawable/ic_add"
                android:drawablePadding="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Mới"
                android:contentDescription="Tạo bài mới"
                android:textSize="@dimen/text_16" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/tab_published"
                style="@style/T"
                android:layout_height="wrap_content"
        android:minHeight="40dp"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Đã đăng (6)"
                android:textColor="@color/white"
                android:textSize="@dimen/text_16"
                android:textStyle="bold" />

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:id="@+id/tab_drafts"
                style="@style/T"
                android:layout_height="wrap_content"
        android:minHeight="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Bản nháp (2)"
                android:textSize="@dimen/text_16" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/list_posts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="16dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
    <ImageView
        android:tag="deco" android:layout_width="150dp" android:layout_height="110dp" android:layout_gravity="end" android:importantForAccessibility="no" android:scaleType="centerCrop" android:src="@drawable/img_deco_panicle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="48dp">
            <ImageView
    android:layout_width="40dp"
    android:layout_height="40dp" android:id="@+id/btn_back" style="@style/Back" android:layout_gravity="center_vertical" android:layout_marginStart="14dp" />
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H2" android:layout_gravity="center" android:id="@+id/screen_title"
 tools:text="Thêm nhật ký" android:textSize="@dimen/text_22" />
        </FrameLayout>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
            <LinearLayout android:id="@+id/row_field" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card" android:gravity="center_vertical" android:orientation="horizontal" android:padding="8dp">
                <com.google.android.material.imageview.ShapeableImageView style="@style/Round10" android:layout_width="86dp" android:layout_height="52dp" android:scaleType="centerCrop" android:id="@+id/field_thumb" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:text="Ruộng đang chọn" android:textSize="@dimen/text_14" />
                    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:id="@+id/field_name" style="@style/T" android:layout_marginTop="1dp" tools:text="Ruộng Bờ Đông" android:textColor="@color/ink_deep" android:textSize="@dimen/text_19" android:textStyle="bold" />
                    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:layout_marginTop="2dp" android:drawableStart="@drawable/ic_location_on" android:drawablePadding="3dp" android:drawableTint="@color/primary" android:id="@+id/field_place"
 tools:text="Thửa A - Xã Thái Hưng, Huyện Thái Thụy, Thái Bình" android:textSize="@dimen/text_13" />
                </LinearLayout>
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_chevron_right" app:tint="@color/ink_deep" />
            </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_calendar" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Ngày thực hiện *" android:textSize="@dimen/text_16" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <TextView
    android:layout_width="match_parent" android:id="@+id/dd_date" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="40dp" android:drawableEnd="@drawable/ic_calendar" android:drawableTint="@color/ink_deep" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="12/05/2025" android:textSize="@dimen/text_16" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_menu_book" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Loại hoạt động *" android:textSize="@dimen/text_16" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <TextView
    android:layout_width="match_parent" android:id="@+id/dd_type" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="40dp" android:drawableStart="@drawable/ic_sprout" android:drawableEnd="@drawable/ic_expand_more" android:drawablePadding="8dp" android:drawableTint="@color/primary" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="Chăm sóc" android:textSize="@dimen/text_16" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_description" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Tiêu đề *" android:textSize="@dimen/text_16" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <EditText
    android:layout_width="match_parent" android:id="@+id/input_title" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="40dp" android:hint="Ví dụ: Bón phân đợt 2, Phun thuốc phòng bệnh..." android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="@dimen/text_15" android:inputType="textCapSentences" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_edit_note" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Ghi chú chi tiết" android:textSize="@dimen/text_16" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <EditText
    android:layout_width="match_parent" android:id="@+id/input_notes" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="84dp" android:gravity="top|start" android:hint="Nhập chi tiết công việc đã thực hiện, tình trạng ruộng, hiệu quả quan sát được..." android:inputType="textMultiLine|textCapSentences" android:maxLength="500" android:maxLines="4" android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="20dp" android:textSize="@dimen/text_15" />
                <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:id="@+id/counter" style="@style/T.Small" android:layout_gravity="bottom|end" android:layout_marginEnd="10dp" android:layout_marginBottom="6dp" android:text="0/500" android:textSize="@dimen/text_14" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_eco" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Vật tư sử dụng" android:textSize="@dimen/text_16" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="40dp" android:background="@drawable/bg_input" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="12dp" android:paddingEnd="12dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:importantForAccessibility="no" android:src="@drawable/ic_search" app:tint="@color/muted" />
                <EditText android:id="@+id/input_material" style="@style/T" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="8dp" android:layout_weight="1" android:background="@null" android:hint="Tìm hoặc nhập tên vật tư..." android:inputType="text" android:maxLines="1" android:textColorHint="@color/hint" android:textSize="@dimen/text_15" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_inventory" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Số lượng hoặc chi phí" android:textSize="@dimen/text_16" />
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:text="(tùy chọn)" android:textSize="@dimen/text_14" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <EditText
    android:layout_width="match_parent" android:id="@+id/input_amount" style="@style/Input" android:layout_height="wrap_content"
        android:minHeight="40dp" android:hint="Ví dụ: 50 kg, 1 lít, 200.000 đ..." android:paddingStart="12dp" android:paddingEnd="12dp" android:textSize="@dimen/text_15" android:inputType="text" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_photo_outline" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Đính kèm ảnh" android:textSize="@dimen/text_16" />
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:text="(tùy chọn)" android:textSize="@dimen/text_14" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/btn_attach" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_dashed_box" android:gravity="center" android:orientation="vertical" android:paddingTop="10dp" android:paddingBottom="10dp">
                <ImageView android:layout_width="26dp" android:layout_height="26dp" android:importantForAccessibility="no" android:src="@drawable/ic_photo_camera" app:tint="@color/primary" />
                <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Link" android:layout_marginTop="4dp" android:text="Chụp ảnh hoặc chọn từ thư viện" android:textSize="@dimen/text_15" />
                <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.Small" android:layout_marginTop="2dp" android:text="Hỗ trợ ảnh dạng JPG, PNG (tối đa 5 ảnh)" android:textSize="@dimen/text_13" />
            </LinearLayout>
            <LinearLayout android:id="@+id/list_attached" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_circle_tint">
            <ImageView android:layout_width="19dp" android:layout_height="19dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_cloud" app:tint="@color/primary" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:orientation="vertical">
            <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" style="@style/T.H3" android:text="Trạng thái thời tiết" android:textSize="@dimen/text_16" />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="vertical">
            <LinearLayout android:id="@+id/list_weather" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
        </LinearLayout>
        </ScrollView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/bg" android:orientation="horizontal" android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="14dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/btn_cancel" style="@style/Btn.Soft" android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="48dp" android:layout_weight="1" android:text="Hủy" />
            <com.example.project_final.view.IconTextView android:id="@+id/btn_save" style="@style/Btn.Primary" android:layout_width="0dp" android:layout_height="wrap_content"
        android:minHeight="48dp" android:layout_marginStart="10dp" android:layout_weight="1.3" android:drawableStart="@drawable/ic_check_circle" android:text="Lưu nhật ký" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="48dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:id="@+id/btn_back"
                    style="@style/Back"
                    android:layout_gravity="center_vertical" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.H2"
                    android:layout_gravity="center"
                    android:text="Chi tiết ruộng"
                    android:textSize="@dimen/text_22" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="170dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        style="@style/Round12"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:id="@+id/field_photo" />

                    <FrameLayout
                        android:id="@+id/btn_zoom"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_circle_dark">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_zoom_in"
                            app:tint="@color/white" />
                    </FrameLayout>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="4dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T"
                        android:id="@+id/field_name"
                        tools:text="Ruộng Bờ Đông"
                        android:textColor="@color/ink_deep"
                        android:textSize="@dimen/text_23"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Small"
                        android:layout_marginTop="5dp"
                        android:drawableStart="@drawable/ic_location_on"
                        android:drawablePadding="5dp"
                        android:drawableTint="@color/primary"
                        android:id="@+id/field_place"
                        tools:text="Thửa A - Xã Thái Hưng, Huyện Thái Thụy, Thái Bình"
                        android:textColor="@color/ink"
                        android:textSize="@dimen/text_15" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="7dp"
                        android:background="#EEEDE5" />

                    <LinearLayout
                        android:id="@+id/list_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/act_edit"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_edit"
                        app:tint="@color/ink_deep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Chỉnh sửa"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/act_scan"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_crop_free"
                        app:tint="@color/ink_deep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="Quét cho ruộng"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/act_recheck"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_calendar"
                        app:tint="@color/ink_deep" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:id="@+id/recheck_btn_label"
                        android:text="Đặt ngày\ntái kiểm tra"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>
            </LinearLayout>

            <!-- recent scans -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_height="wrap_content"
                        style="@style/T.H3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Lần quét gần đây" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/link_scans"
                        style="@style/T.Link"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawableTint="@color/primary"
                        android:text="Xem tất cả"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_scans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/banner_recheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_banner_tint"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_tint">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_calendar"
                            app:tint="@color/primary" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Small"
                            android:text="Lần tái kiểm tra tiếp theo"
                            android:textColor="@color/ink"
                            android:textSize="@dimen/text_14" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:id="@+id/recheck_date"
                                style="@style/T"
                                tools:text="01/05/2025"
                                android:textColor="@color/ink_deep"
                                android:textSize="@dimen/text_20"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/T.Small"
                                android:layout_marginStart="6dp"
                                android:layout_marginBottom="2dp"
                                android:id="@+id/recheck_left"
                                tools:text="(còn 7 ngày)"
                                android:textColor="@color/ink"
                                android:textSize="@dimen/text_14" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.Pill"
                        android:background="@drawable/bg_btn_primary"
                        android:drawableStart="@drawable/ic_check_circle"
                        android:drawableTint="@color/white"
                        android:paddingTop="9dp"
                        android:paddingBottom="9dp"
                        android:id="@+id/recheck_state"
                        tools:text="Đã đặt"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>
            </LinearLayout>

            <!-- diary -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_height="wrap_content"
                        style="@style/T.H3"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="Nhật ký chăm sóc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/link_diary"
                        style="@style/T.Link"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawableTint="@color/primary"
                        android:text="Xem thêm"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_diary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <com.example.project_final.view.IconTextView
                android:id="@+id/act_delete"
                style="@style/Btn.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:drawableStart="@drawable/ic_delete_outline"
                android:minHeight="50dp"
                android:text="Xóa ruộng này" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>

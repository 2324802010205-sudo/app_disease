<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="115dp"
        android:layout_height="140dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_tl" />

    <ImageView
        android:tag="deco"
        android:layout_width="90dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_tr" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="30dp"
            android:paddingEnd="22dp"
            android:paddingBottom="16dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="66dp"
                android:layout_gravity="center_horizontal"
                android:importantForAccessibility="no"
                android:src="@drawable/img_logo" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T"
                    android:text="RiceGuard "
                    android:textColor="@color/ink_deep"
                    android:textSize="@dimen/text_22"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T"
                    android:text="AI"
                    android:textColor="@color/green_ok"
                    android:textSize="@dimen/text_22"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Title"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="26dp"
                android:id="@+id/screen_title"
                android:text="Tạo tài khoản"
                android:textSize="@dimen/text_29" />

            <TextView
                android:id="@+id/screen_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.Sub"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tham gia RiceGuard AI để cùng bảo vệ mùa màng với công nghệ thông minh" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:id="@+id/input_name"
                style="@style/Input"
                android:layout_marginTop="20dp"
                android:drawableStart="@drawable/ic_person_outline"
                android:hint="Họ và tên"
                android:inputType="textPersonName" />

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:id="@+id/input_email"
                style="@style/Input"
                android:layout_marginTop="10dp"
                android:drawableStart="@drawable/ic_mail"
                android:hint="Email"
                android:inputType="textEmailAddress" />

            <FrameLayout
                android:id="@+id/row_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
        android:minHeight="52dp"
                    android:id="@+id/input_password"
                    style="@style/Input"
                    android:drawableStart="@drawable/ic_lock_outline"
                    android:hint="Mật khẩu"
                    android:inputType="textPassword"
                    android:paddingEnd="48dp" />

                <ImageView
                    android:id="@+id/btn_toggle_password"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_gravity="end"
                    android:contentDescription="Hiện mật khẩu"
                    android:padding="12dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/ink"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/row_confirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <EditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
        android:minHeight="52dp"
                    android:id="@+id/input_confirm"
                    style="@style/Input"
                    android:drawableStart="@drawable/ic_lock_outline"
                    android:hint="Xác nhận mật khẩu"
                    android:inputType="textPassword"
                    android:paddingEnd="48dp" />

                <ImageView
                    android:id="@+id/btn_toggle_confirm"
                    android:layout_width="44dp"
                    android:layout_height="52dp"
                    android:layout_gravity="end"
                    android:contentDescription="Hiện mật khẩu"
                    android:padding="12dp"
                    android:src="@drawable/ic_visibility_off"
                    app:tint="@color/ink"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/check_terms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@drawable/bg_check_box"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Body"
                    android:layout_marginStart="2dp"
                    android:text="Tôi đồng ý với "
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Link"
                    android:text="điều khoản sử dụng" />
            </LinearLayout>

            <com.example.project_final.view.IconTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:id="@+id/btn_create"
                style="@style/Btn.Primary"
                android:layout_marginTop="14dp"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:text="Tạo tài khoản" />

            <LinearLayout
                android:id="@+id/group_google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#DADFD3" />

                    <TextView
                        style="@style/T.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginEnd="14dp"
                        android:text="Hoặc" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#DADFD3" />
                </LinearLayout>

                <com.example.project_final.view.IconTextView
                    android:id="@+id/btn_google"
                    style="@style/Btn.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:drawableStart="@drawable/ic_google"
                    android:drawableTint="@null"
                    android:minHeight="52dp"
                    android:text="Đăng ký với Google"
                    android:textColor="@color/ink_deep" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Body"
                    android:text="Đã có tài khoản? "
                    android:textColor="@color/ink"
                    android:textSize="@dimen/text_17" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/btn_login"
                    style="@style/T.Link"
                    android:text="Đăng nhập"
                    android:textSize="@dimen/text_17" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>

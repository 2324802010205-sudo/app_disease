<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:tag="deco"
        android:layout_width="150dp"
        android:layout_height="110dp"
        android:layout_gravity="end"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_deco_panicle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:minHeight="48dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:id="@+id/btn_back"
                style="@style/Back"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/T.H2"
                android:layout_gravity="center"
                android:id="@+id/screen_title"
                tools:text="Tạo bài viết"
                android:textSize="@dimen/text_22" />
        </FrameLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.Small"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginStart="26dp"
                    android:layout_marginEnd="26dp"
                    android:gravity="center"
                    android:text="Chia sẻ kinh nghiệm, câu hỏi hoặc quan sát trên đồng ruộng để cộng đồng cùng trao đổi và hỗ trợ."
                    android:textSize="@dimen/text_15" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.H3"
                    android:layout_marginTop="14dp"
                    android:text="Tiêu đề *"
                    android:textSize="@dimen/text_17" />

                <EditText
                    android:layout_width="match_parent"
                    android:id="@+id/input_title"
                    style="@style/Input"
                    android:layout_height="wrap_content"
        android:minHeight="44dp"
                    android:layout_marginTop="6dp"
                    android:hint="Nhập tiêu đề bài viết..."
                    android:inputType="textCapSentences"
                    android:maxLength="100"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/counter_title"
                    style="@style/T.Small"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="0/100"
                    android:textSize="@dimen/text_14" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.H3"
                    android:layout_marginTop="6dp"
                    android:text="Chủ đề *"
                    android:textSize="@dimen/text_17" />

                <TextView
                    android:layout_width="match_parent"
                    android:id="@+id/dd_topic"
                    style="@style/Input"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:layout_marginTop="6dp"
                    android:drawableStart="@drawable/ic_sprout"
                    android:drawableEnd="@drawable/ic_expand_more"
                    android:drawableTint="@color/primary"
                    android:gravity="center_vertical"
                    android:text="Chọn chủ đề phù hợp..."
                    android:textColor="@color/hint"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/T.H3"
                    android:layout_marginTop="14dp"
                    android:text="Nội dung *"
                    android:textSize="@dimen/text_17" />

                <EditText
                    android:layout_width="match_parent"
                    android:id="@+id/input_content"
                    style="@style/Input"
                    android:layout_height="wrap_content"
        android:minHeight="82dp"
                    android:layout_marginTop="6dp"
                    android:gravity="top|start"
                    android:hint="Chia sẻ chi tiết về tình trạng cây lúa, cách xử lý, kinh nghiệm của bạn hoặc đặt câu hỏi cho cộng đồng..."
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLength="2000"
                    android:maxLines="4"
                    android:paddingTop="12dp"
                    android:textSize="@dimen/text_16" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/counter_content"
                    style="@style/T.Small"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:text="0/2000"
                    android:textSize="@dimen/text_14" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/T.H3"
                        android:text="Thêm ảnh"
                        android:textSize="@dimen/text_17" />

                    <TextView
                        android:layout_height="wrap_content"
                        style="@style/T.Small"
                        android:layout_width="0dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="(tối đa 5 ảnh)"
                        android:textSize="@dimen/text_15" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/counter_photos"
                        style="@style/T.Small"
                        tools:text="0/5"
                        android:textSize="@dimen/text_15" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/list_photos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.H3"
                            android:text="Xem trước bài viết"
                            android:textSize="@dimen/text_17" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/T.Small"
                            android:layout_marginStart="8dp"
                            android:drawableStart="@drawable/ic_visibility"
                            android:drawablePadding="4dp"
                            android:drawableTint="@color/muted"
                            android:text="Bài viết sẽ hiển thị như thế này"
                            android:textSize="@dimen/text_14" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@drawable/bg_circle_tint">

                                <ImageView
                                    android:layout_width="18dp"
                                    android:layout_height="18dp"
                                    android:layout_gravity="center"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_person"
                                    app:tint="@color/primary" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T"
                                    android:id="@+id/preview_author"
                                    tools:text="Bạn"
                                    android:textSize="@dimen/text_16"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    style="@style/T.Small"
                                    android:text="Vừa xong  ·  Cộng đồng nông dân"
                                    android:textSize="@dimen/text_13" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_more_vert"
                                app:tint="@color/ink" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_title"
                            style="@style/T"
                            android:layout_marginTop="8dp"
                            android:text="Tiêu đề bài viết của bạn sẽ hiển thị ở đây"
                            android:textSize="@dimen/text_17"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/preview_content"
                            style="@style/T.Small"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Nội dung bài viết của bạn sẽ hiển thị ở đây..."
                            android:textSize="@dimen/text_15" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card_tint_green" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card_tint_green" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="60dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_card_tint_green" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bar_bottom"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <com.example.project_final.view.IconTextView
                android:id="@+id/btn_preview"
                android:visibility="gone"
                style="@style/Btn.Soft"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_visibility"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Xem trước"
                android:textSize="@dimen/text_16" />

            <com.example.project_final.view.IconTextView
                android:id="@+id/btn_draft"
                style="@style/Btn.Outline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_description"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Lưu nháp"
                android:textSize="@dimen/text_16" />

            <com.example.project_final.view.IconTextView
                android:id="@+id/btn_publish"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_send"
                android:drawablePadding="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="Đăng bài"
                android:textSize="@dimen/text_16" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/img_onboard_hero" />

        <View
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_fade_white" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="26dp"
        android:paddingEnd="26dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/T"
            android:layout_gravity="center_horizontal"
            android:gravity="center"
            android:text="Phát hiện bệnh lá lúa"
            android:textColor="@color/ink_deep"
            android:textSize="@dimen/text_28"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/T"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="dễ dàng"
            android:textColor="@color/green_ok"
            android:textSize="@dimen/text_28"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/T.Sub"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Chỉ cần chụp ảnh lá lúa, RiceGuard AI sẽ nhanh chóng nhận diện bệnh và đưa ra khuyến nghị phù hợp."
            android:textSize="@dimen/text_18" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="18dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_tab_selected" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_tint"
                android:backgroundTint="#D9E1D3" />

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_tint"
                android:backgroundTint="#D9E1D3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_skip"
                style="@style/T.Link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="Bỏ qua"
                android:textSize="@dimen/text_18" />

            <com.example.project_final.view.IconTextView
                android:layout_height="wrap_content"
        android:minHeight="52dp"
                android:id="@+id/btn_next"
                style="@style/Btn.Primary"
                android:layout_width="0dp"
                android:layout_weight="1.55"
                android:drawableEnd="@drawable/ic_arrow_forward"
                android:text="Tiếp tục" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
